# RecoverAI Backend Environment Configuration

# PostgreSQL database connection (existing setup)
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/recoverai

# Razorpay TEST MODE credentials
# Replace with real Razorpay TEST keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Local Ollama AI decision engine
# OLLAMA_MODEL must name an installed model, e.g. qwen3:8b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120

# Polygon Amoy testnet blockchain configuration (chain ID 80002)
# NEVER commit real private keys to source control.
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
RECOVERY_PROOF_CONTRACT_ADDRESS=0x_YOUR_DEPLOYED_CONTRACT_ADDRESS
POLYGON_CHAIN_ID=80002

# Recovery execution safety switch.
# Defaults to TRUE (SAFE). While true the engine NEVER calls Razorpay for a real
# recovery action and always returns a SIMULATED result.
# Set RECOVERY_DRY_RUN=false ONLY for Razorpay TEST/SANDBOX testing.
# It must NEVER default to false in production.
RECOVERY_DRY_RUN=true
