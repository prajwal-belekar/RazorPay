# RecoverAI Backend Environment Configuration

# PostgreSQL database connection (existing setup)
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/recoverai

# Razorpay TEST MODE credentials
# Replace with real Razorpay TEST keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Local Ollama AI decision engine
# OLLAMA_MODEL must name an installed model, e.g. qwen3:8b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120
